<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <title>Password Management Links Fragment</title>
    <link href="../../static/css/cas.css" rel="stylesheet" th:remove="tag" />
</head>

<body>
<div th:fragment="pmlinks" id="pmlinks" class="my-2">

    <form th:if="${accountRegistrationEnabled}" method="post" id="accountMgmtSignupForm" class="pm-item">
        <input type="hidden" name="execution" th:value="${flowExecutionKey}" />
        <input type="hidden" name="_eventId" value="signup" />
        <span class="mdi mdi-account-group" aria-hidden="true"></span>
        <a id="accountSignUpLink" class="pm-link pm-btn pm-fancy "
           th:utext="#{screen.acct.button.signUp}" href="javascript:void(0)"
           onclick="document.getElementById('accountMgmtSignupForm').submit()"></a>
    </form>

    <form th:if="${passwordManagementEnabled}" method="post" id="passwordManagementForm" class="pm-item">
        <input type="hidden" name="execution" th:value="${flowExecutionKey}" />
        <input type="hidden" name="_eventId" value="resetPassword" />
        <span class="mdi mdi-lock-open" aria-hidden="true"></span>
	<a id="forgotPasswordLink" class="pm-link pm-btn"
	   th:utext="#{screen.pm.button.resetPassword}" href="javascript:void(0)"
           onclick="document.getElementById('passwordManagementForm').submit();"></a>
    </form>

    <form th:if="${#bools.isTrue(passwordManagementEnabled) && #bools.isTrue(forgotUsernameEnabled)}"
          method="post" id="forgotUsernameForm" class="pm-item">
        <input type="hidden" name="execution" th:value="${flowExecutionKey}" />
        <input type="hidden" name="_eventId" value="forgotUsername" />
        <span class="mdi mdi-account-question" aria-hidden="true"></span>
        <a id="forgotUsernameLink" class="pm-link pm-btn"
           th:utext="#{screen.pm.button.forgotUsername}" href="javascript:void(0)"
           onclick="document.getElementById('forgotUsernameForm').submit();"></a>
    </form>

    <div th:unless="${passwordManagementEnabled}" class="pm-item">
        <span class="mdi mdi-account-question" aria-hidden="true"></span>
        <a class="pm-link pm-btn"
           th:href="@{https://sesame.univ-antilles.fr/fusiondirectory/recovery.php?contrat=accepte}"
           th:utext="#{screen.pm.button.forgotpwd('https://sesame.univ-antilles.fr/fusiondirectory/recovery.php?contrat=accepte')}">
           Mot de passe oublié
        </a>
    </div>

    <div class="pm-item align-end">
        <span class="mdi mdi-lifebuoy" aria-hidden="true"></span>
        <a id="supportLink" class="pm-link pm-btn "
           th:href="@{https://assistance.univ-antilles.fr}"
           target="_blank" rel="noopener"
           th:text="#{screen.help.button.support}">
           Demander assistance
        </a>
    </div>

</div>

</body>

</html>
