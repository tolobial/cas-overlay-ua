/* ==========================================================
 * -modification du logo
 * ========================================================== */


#cas-logo, .cas-logo { height: 72px; width: auto; }


/* =========================================================
   UA CAS - custom.css
   - Grille 2 colonnes pour les actions du login (#pmlinks)
   - Boutons unifiés (submit <button> et liens <a>)
   - Icônes alignées
   - Centrage du paragraphe de sécurité sous les liens
   - Option calligraphie (pm-fancy)
   ========================================================= */

/* ---- Option police manuscrite élégante ----
   Active-la au cas par cas avec la classe .pm-fancy.
   (Si la CSP bloque Google Fonts, on passera en @font-face auto-hébergé.) */
@import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap');

/* ====== Grille 2 colonnes pour le fragment pmlinks ====== */
#pmlinks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: .5rem 1.25   /* espace horizontal */
  margin-top: .5rem;
}

/* Empile en 1 colonne sur petit écran */
@media (max-width: 640px) {
  #pmlinks { grid-template-columns: 1fr; }
}

/* Chaque bouton prend 100% de sa colonne */
#pmlinks .pm-btn,
#pmlinks button.pm-btn {
  width: 100%;
  box-sizing: border-box;
}

/* Chaque entrée (icône + bouton) */
#pmlinks .pm-item {
  display: flex;
  align-items: center;
  gap: .5rem;
}

/* Aligne l’item sur le bord droit de la colonne (ex: Assistance) */
#pmlinks .pm-item.align-end {
  justify-self: end;
}

/* Icônes Material Design */
#pmlinks .mdi {
  font-size: 1rem;
  line-height: 1;
  opacity: .9;
}

/* ====== Boutons unifiés (pour <button> et <a>) ======
   NB: on cible .pm-btn et aussi button.pm-btn explicitement pour
   éviter tout style navigateur/thème qui écraserait le rendu. */
#pmlinks .pm-btn,
#pmlinks button.pm-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;

  padding: .45rem .9rem;
  border: 1px solid var(--cas-accent, #1e88e5);
  border-radius: .6rem;

  color: var(--cas-accent, #29b6f6);
  background: transparent;

  font-weight: 600;
  text-decoration: none !important;  /* neutralise les soulignements forcés */
  text-align: center;
  min-width: 14rem;

  transition: background .15s ease, border-color .15s ease, color .15s ease;
  cursor: pointer;                    /* cohérent pour <button> et <a> */
}

/* Hover/focus */
#pmlinks .pm-btn:hover,
#pmlinks button.pm-btn:hover,
#pmlinks .pm-btn:focus,
#pmlinks button.pm-btn:focus {
  background: rgba(41, 182, 246, .12);
  outline: 0;
  text-decoration: none !important;
}

/* Variante « plein » (utiliser .pm-filled en plus de .pm-btn si souhaité) */
#pmlinks .pm-btn.pm-filled,
#pmlinks button.pm-btn.pm-filled {
  background: var(--cas-accent, #1e88e5);
  color: #0b1216;                     /* lisible sur thème sombre */
  border-color: var(--cas-accent, #1e88e5);
}
#pmlinks .pm-btn.pm-filled:hover,
#pmlinks button.pm-btn.pm-filled:hover {
  filter: brightness(1.1);
}



<button class="round-btn">✔</button>
.round-btn {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background-color: #007bff;
  color: white;
  border: none;
  font-size: 24px;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.round-btn:hover {
  background-color: #0056b3;
}




/* ====== Calligraphie élégante (à activer avec .pm-fancy) ====== */
.pm-fancy {
  font-family: 'Dancing Script', cursive;
  letter-spacing: .3px;
  /* Option : dé-commente si tu veux un peu plus grand */
  /* font-size: 1.05rem; */
}

/* ====== Paragraphe de sécurité sous le bloc liens ======
   Centre tout <p> qui suit #pmlinks dans le DOM (ex: message sécurité). */
#pmlinks ~ p {
  text-align: center;
  margin-top: .75rem;
}

/* Si tu veux aussi la calligraphie sur ce paragraphe,
   ajoute la classe 'pm-fancy' au <p> dans le template login.html. */
#pmlinks ~ p.pm-fancy {
  font-family: 'Dancing Script', cursive;
  letter-spacing: .3px;
}

/* =========================================================
   PATCH DIAGNOSTIC (optionnel) :
   Si ton thème force encore des styles et que le rendu n’évolue pas,
   dé-commente les lignes ci-dessous le temps d’identifier la règle
   qui écrase tes boutons (met des !important partout).
   ========================================================= */
