#cas-logo, .cas-logo { height: 72px; width: auto; }

/* Option police manuscrite : Google Fonts (simple) */
@import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600&display=swap');

/* Grille 2 colonnes (déjà en place) */
#pmlinks{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  column-gap:1.25rem; row-gap:.5rem;
}
@media (max-width:640px){ #pmlinks{ grid-template-columns:1fr; } }

#pmlinks .pm-item{ display:flex; align-items:center; gap:.5rem; }
#pmlinks .pm-item.align-end{ justify-self:end; } /* pousse le bouton de droite */

/* Style bouton + centrage du libellé */
#pmlinks .pm-btn{
  display:inline-flex; align-items:center; justify-content:center;
  padding:.45rem .9rem;
  border:1px solid var(--cas-accent,#1e88e5);
  border-radius:.6rem;
  color:var(--cas-accent,#29b6f6);
  background:transparent;
  font-weight:600;
  text-decoration:none;
  text-align:center;              /* centre le texte à l’intérieur */
  min-width: 14rem;               /* occupe mieux l’espace */
}
#pmlinks .pm-btn:hover,#pmlinks .pm-btn:focus{
  background:rgba(41,182,246,.12);
  text-decoration:none;
  outline:0;
}

/* Police manuscrite élégante (n'appliquer qu'aux boutons voulus) */
#pmlinks .pm-fancy{
  font-family: 'Dancing Script', cursive;
  letter-spacing:.3px;
  font-weight:600;
}

